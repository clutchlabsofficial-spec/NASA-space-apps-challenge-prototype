# Claude — used for reviewing children's own subsystem ideas.
ANTHROPIC_API_KEY=sk-ant-...

# Tripo AI — used for turning a photographed sketch into a 3D model.
TRIPO_API_KEY=tsk_...

# Optional overrides
# TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
# TRIPO_UPLOAD_PATH=/upload/sts     # change if Tripo's upload path differs
# TRIPO_MODEL=P1-20260311
# TRIPO_FACE_LIMIT=8000

# Budget guards (per browser session unless noted)
# SESSION_IDEA_LIMIT=40
# SESSION_MODEL_LIMIT=4
# GLOBAL_MODEL_LIMIT=200            # across the whole server, for the day
# MAX_REQUESTS_PER_MINUTE=20

# PORT=8787
# ALLOWED_ORIGIN=http://localhost:5173
